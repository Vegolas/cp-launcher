<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CpLauncher.ViewModels"
             xmlns:views="clr-namespace:CpLauncher.Views"
             xmlns:services="clr-namespace:CpLauncher.Services"
             x:Class="CpLauncher.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <!--
      Title bar: name and version on the left, Odśwież / Ustawienia before the window's caption buttons. Controls
      in the drag region need ElementRole="User": the window's hit test ignores elements without a role, so a
      click would fall through to the TitleBar and move the window instead.
    -->
    <Border Classes="titlebar" WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,0,148,0">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Path Classes="mark" VerticalAlignment="Center" />
          <TextBlock Classes="heading" Text="CP Launcher" VerticalAlignment="Center" />
          <TextBlock Classes="muted small" Text="{Binding LauncherVersionText}" VerticalAlignment="Center" Margin="2,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="ghost" Command="{Binding RefreshCommand}" WindowDecorationProperties.ElementRole="User"
                  ToolTip.Tip="Pobiera przepisy jeszcze raz i sprawdza Icon.utx.">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="glyph" Text="&#xE72C;" />
              <TextBlock Text="Odśwież" />
            </StackPanel>
          </Button>
          <ToggleButton Classes="ghost" IsChecked="{Binding IsSettingsOpen}" WindowDecorationProperties.ElementRole="User">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="glyph" Text="&#xE713;" />
              <TextBlock Text="Ustawienia" />
            </StackPanel>
          </ToggleButton>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main page -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsSettingsOpen}">
      <StackPanel Margin="24,20,24,24" Spacing="16" MaxWidth="1200">
        <!-- Launcher update -->
        <Border Classes="notice update" IsVisible="{Binding UpdateText, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="glyph" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Classes="strong" Text="{Binding UpdateText}" TextWrapping="Wrap" />
              <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding UpdateHint}"
                         IsVisible="{Binding UpdateHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="accent" Margin="16,0,0,0" VerticalAlignment="Center" Content="Aktualizuj"
                    Command="{Binding UpdateLauncherCommand}"
                    ToolTip.Tip="Pobiera nową wersję, sprawdza ją z podpisanymi przepisami i uruchamia launcher ponownie." />
          </Grid>
        </Border>

        <!-- Banners -->
        <ItemsControl ItemsSource="{Binding Banners}" IsVisible="{Binding !!Banners.Count}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NoticeViewModel">
              <Border Classes="notice"
                      Classes.success="{Binding IsSuccess}"
                      Classes.warning="{Binding IsWarning}"
                      Classes.error="{Binding IsError}">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Classes="glyph" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Status of Icon.utx and the actions on it -->
        <Border Classes="status"
                Classes.success="{Binding IconState.IsSuccess}"
                Classes.warning="{Binding IconState.IsWarning}"
                Classes.error="{Binding IconState.IsError}"
                Classes.pending="{Binding PendingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="stripe" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" Margin="20,18,20,18">
              <TextBlock Classes="glyph" />
              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="headline" Text="{Binding IconState.Text}" />
                <TextBlock Classes="prose" Text="{Binding PendingText}"
                           IsVisible="{Binding PendingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="muted small" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding ManifestSummary}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="20,0,0,0">
                <Button Content="Przywróć oryginał" Command="{Binding RestoreOriginalCommand}"
                        IsVisible="{Binding HasOriginalToRestore}"
                        ToolTip.Tip="Przywraca kopię oryginalnego Icon.utx zrobioną przed pierwszą zmianą." />
                <Button Classes="apply" Content="Zastosuj" Command="{Binding ApplyCommand}" MinWidth="120"
                        HorizontalContentAlignment="Center" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,20,320">
          <!-- Packs; this and the right column's sections collapse, and the launcher remembers it -->
          <Expander Theme="{StaticResource SectionExpander}" IsExpanded="{Binding PacksSection.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="heading" Text="Paczki" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="muted small" VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="{Binding PacksSection.Summary}" IsVisible="{Binding !PacksSection.IsExpanded}" />
              </Grid>
            </Expander.Header>
            <StackPanel>
              <TextBlock Classes="muted small" TextWrapping="Wrap"
                         Text="Podgląd liczony z Twojego Icon.utx. Zaznacz paczki i kliknij „Zastosuj”." />
              <TextBlock Classes="muted" Margin="0,12,0,0" TextWrapping="Wrap" Text="Lider nie udostępnił paczek."
                         IsVisible="{Binding !Packs.Count}" />
              <ItemsControl ItemsSource="{Binding Packs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PackViewModel">
                    <Border Classes="pack" Classes.off="{Binding !IsSelected}" Padding="0,14,0,10"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0">
                      <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                          <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEditable}" MinHeight="0">
                            <TextBlock Classes="strong" FontSize="15" Text="{Binding Name}" TextWrapping="Wrap" />
                          </CheckBox>
                          <Border Grid.Column="1" Classes="count" Margin="12,0,0,0">
                            <TextBlock Classes="muted small" Text="{Binding SizeText}" />
                          </Border>
                        </Grid>
                        <TextBlock Classes="muted prose" Margin="28,2,0,0"
                                   Text="{Binding Description}"
                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <StackPanel Margin="28,12,0,0" Spacing="4">
                          <ItemsControl Classes="buffbar" ItemsSource="{Binding Thumbnails}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ThumbnailViewModel">
                                <Border Classes="slot" ToolTip.Tip="{Binding Target}">
                                  <Image Width="64" Height="64" Stretch="Fill"
                                         RenderOptions.BitmapInterpolationMode="None"
                                         Source="{Binding Image, Converter={x:Static views:RgbaImageConverter.Instance}}" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Classes="muted small" Text="{Binding PreviewNote}"
                                     IsVisible="{Binding PreviewNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>

          <!-- Right column: announcements, Option.ini presets -->
          <StackPanel Grid.Column="2" Spacing="16">
            <Expander Theme="{StaticResource SectionExpander}" IsExpanded="{Binding AnnouncementsSection.IsExpanded, Mode=TwoWay}">
              <Expander.Header>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="heading" Text="Ogłoszenia" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="muted small" VerticalAlignment="Center" Margin="12,0,0,0"
                             Text="{Binding AnnouncementsSection.Summary}" IsVisible="{Binding !AnnouncementsSection.IsExpanded}" />
                </Grid>
              </Expander.Header>
              <StackPanel Spacing="14">
                <TextBlock Classes="muted" Text="Brak ogłoszeń od lidera." IsVisible="{Binding !HasAnnouncements}" />
                <ItemsControl ItemsSource="{Binding Announcements}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="16" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AnnouncementViewModel">
                      <StackPanel Spacing="3">
                        <TextBlock Classes="small" Foreground="{StaticResource GoldBrush}" Text="{Binding DateText}" />
                        <TextBlock Classes="strong" Text="{Binding Title}" TextWrapping="Wrap" />
                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Expander>

            <Expander Theme="{StaticResource SectionExpander}" IsExpanded="{Binding PresetsSection.IsExpanded, Mode=TwoWay}">
              <Expander.Header>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="heading" Text="Ustawienia gry" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="muted small" VerticalAlignment="Center" Margin="12,0,0,0"
                             Text="{Binding PresetsSection.Summary}" IsVisible="{Binding !PresetsSection.IsExpanded}" />
                </Grid>
              </Expander.Header>
              <StackPanel Spacing="12">
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Zmieniają tylko wybrane linie w Option.ini." />
                <TextBlock Classes="muted" Text="Lider nie udostępnił presetów." IsVisible="{Binding !HasPresets}" />
                <ItemsControl ItemsSource="{Binding Presets}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PresetViewModel">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="strong" Text="{Binding Name}" />
                            <TextBlock Classes="glyph" FontSize="12" Text="&#xE73E;" Foreground="{StaticResource SuccessBrush}"
                                       VerticalAlignment="Center" IsVisible="{Binding IsApplied}"
                                       ToolTip.Tip="Ustawiony w Twoim Option.ini" />
                          </StackPanel>
                          <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding Summary}" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Content="Ustaw"
                                Command="{Binding $parent[views:DashboardView].((vm:DashboardViewModel)DataContext).ApplyPresetCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="ghost" Padding="0,4" HorizontalAlignment="Left" Content="Przywróć moje ustawienia"
                        Command="{Binding RestoreMySettingsCommand}" IsVisible="{Binding HasSettingsBackup}"
                        ToolTip.Tip="Przywraca Option.ini sprzed pierwszego presetu." />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- Launcher settings and technical details -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsSettingsOpen}">
      <StackPanel Margin="24,20,24,24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost" Command="{Binding CloseSettingsCommand}" ToolTip.Tip="Wróć do paczek" Padding="8,6">
            <TextBlock Classes="glyph" Text="&#xE72B;" />
          </Button>
          <TextBlock Classes="display" Text="Ustawienia" VerticalAlignment="Center" />
        </StackPanel>

        <Border Classes="panel">
          <StackPanel Spacing="18">
            <StackPanel Spacing="8">
              <TextBlock Classes="heading" Text="Klient L2Dex" />
              <Grid ColumnDefinitions="*,Auto">
                <SelectableTextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ClientDirectory}" />
                <Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding ChangeClientFolderCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="glyph" FontSize="14" Text="&#xE838;" VerticalAlignment="Center" />
                    <TextBlock Text="Zmień folder klienta" />
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Spacing="8">
              <TextBlock Classes="heading" Text="Uruchamianie gry" />
              <TextBlock Classes="muted" Text="Program uruchamiany przyciskiem „Uruchom L2Dex”:" />
              <ComboBox ItemsSource="{Binding GameExecutableOptions}" SelectedItem="{Binding SelectedGameExecutable}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="services:GameExecutableOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Spacing="8">
              <TextBlock Classes="heading" Text="Źródło przepisów" />
              <TextBlock Classes="muted prose"
                         Text="Adres https:// albo folder, z którego launcher pobiera podpisane przepisy. Zostaw puste, żeby używać źródła CP." />
              <TextBox Text="{Binding ManifestSourceText}" PlaceholderText="Źródło CP (domyślne)" />
              <TextBlock Classes="muted small" TextWrapping="Wrap">
                <Run Text="Teraz używane:" />
                <Run Text="{Binding ManifestSourceDescription}" />
              </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Classes="accent" Content="Zapisz" Command="{Binding SaveSettingsCommand}" MinWidth="100"
                      HorizontalContentAlignment="Center" />
              <TextBlock Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding SettingsMessage}"
                         IsVisible="{Binding SettingsMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Classes="heading" Text="Szczegóły techniczne" />
              <TextBlock Classes="muted small" TextWrapping="Wrap"
                         Text="Komunikaty, które przydadzą się liderowi, gdy coś nie działa. Można je zaznaczyć i skopiować." />
            </StackPanel>
            <TextBlock Classes="muted" Text="Brak uwag." IsVisible="{Binding !Details.Count}" />
            <ItemsControl ItemsSource="{Binding Details}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Classes="slot" Margin="0" Padding="10,6" BorderThickness="0">
                    <SelectableTextBlock Classes="small" Text="{Binding}" TextWrapping="Wrap" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer: result of the last action and the game start -->
    <Border Grid.Row="2" Padding="24,14" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" MaxWidth="1200">
        <Panel VerticalAlignment="Center" Margin="0,0,24,0">
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" MaxWidth="240" HorizontalAlignment="Left" />
          <Border Classes="notice quiet"
                  Classes.success="{Binding LastAction.IsSuccess}"
                  Classes.warning="{Binding LastAction.IsWarning}"
                  Classes.error="{Binding LastAction.IsError}">
            <Border.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="!IsBusy" />
                <Binding Path="LastAction" Converter="{x:Static ObjectConverters.IsNotNull}" />
              </MultiBinding>
            </Border.IsVisible>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Classes="glyph" />
              <TextBlock Grid.Column="1" Text="{Binding LastAction.Text}" TextWrapping="Wrap" />
            </Grid>
          </Border>
        </Panel>
        <Button Grid.Column="1" Classes="accent play" Command="{Binding LaunchGameCommand}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="glyph" FontSize="14" Text="&#xE768;" VerticalAlignment="Center" />
            <TextBlock Text="Uruchom L2Dex" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
