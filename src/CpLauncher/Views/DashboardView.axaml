<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CpLauncher.ViewModels"
             xmlns:views="clr-namespace:CpLauncher.Views"
             xmlns:services="clr-namespace:CpLauncher.Services"
             x:Class="CpLauncher.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <DockPanel>
    <!-- Header: name, client folder, update indicator, refresh -->
    <Border DockPanel.Dock="Top" Padding="20,14" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="title" Text="CP Launcher" />
            <TextBlock Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,3" Text="{Binding LauncherVersionText}" />
          </StackPanel>
          <TextBlock Classes="muted" Text="{Binding ClientDirectory, StringFormat='Klient: {0}'}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Classes="notice success" Padding="10,4"
                  IsVisible="{Binding UpdateText, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock VerticalAlignment="Center" Text="{Binding UpdateText}" />
              <Button Content="Aktualizuj" IsEnabled="False"
                      ToolTip.Tip="Samoaktualizacja pojawi się w kolejnej wersji launchera." />
            </StackPanel>
          </Border>
          <Button Content="Odśwież" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Footer: result of the last action and the game start -->
    <Border DockPanel.Dock="Bottom" Padding="20,12" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <Panel VerticalAlignment="Center" Margin="0,0,16,0">
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" MaxWidth="240" HorizontalAlignment="Left" />
          <Border Classes="notice"
                  Classes.success="{Binding LastAction.IsSuccess}"
                  Classes.warning="{Binding LastAction.IsWarning}"
                  Classes.error="{Binding LastAction.IsError}">
            <Border.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="!IsBusy" />
                <Binding Path="LastAction" Converter="{x:Static ObjectConverters.IsNotNull}" />
              </MultiBinding>
            </Border.IsVisible>
            <TextBlock Text="{Binding LastAction.Text}" TextWrapping="Wrap" />
          </Border>
        </Panel>
        <Button Grid.Column="1" Classes="accent" FontSize="17" Padding="28,12"
                Content="Uruchom L2Dex" Command="{Binding LaunchGameCommand}" />
      </Grid>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="20,16" Spacing="12">
        <ItemsControl ItemsSource="{Binding Banners}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NoticeViewModel">
              <Border Classes="notice" Margin="0,0,0,6"
                      Classes.success="{Binding IsSuccess}"
                      Classes.warning="{Binding IsWarning}"
                      Classes.error="{Binding IsError}">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="3*,2*">
          <!-- Left column: status, packs, presets -->
          <StackPanel Grid.Column="0" Spacing="12" Margin="0,0,12,0">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="heading" Text="Stan" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                  <TextBlock Classes="label" Text="Przepisy:" />
                  <TextBlock Grid.Column="1" TextWrapping="Wrap">
                    <Run Text="{Binding ManifestVersionText}" FontWeight="SemiBold" />
                    <Run Text=" " />
                    <Run Text="{Binding ManifestOriginText}" Foreground="{StaticResource MutedBrush}" />
                  </TextBlock>
                  <TextBlock Grid.Row="1" Classes="label" Text="Źródło:" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" TextWrapping="Wrap" Text="{Binding ManifestSourceDescription}" />
                  <TextBlock Grid.Row="2" Classes="label" Text="Icon.utx:" Margin="0,6,12,0" />
                  <Border Grid.Row="2" Grid.Column="1" Classes="notice" Margin="0,4,0,0"
                          Classes.success="{Binding IconState.IsSuccess}"
                          Classes.warning="{Binding IconState.IsWarning}"
                          Classes.error="{Binding IconState.IsError}">
                    <TextBlock Text="{Binding IconState.Text}" TextWrapping="Wrap" />
                  </Border>
                </Grid>
                <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap"
                           IsVisible="{Binding PendingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="heading" Text="Paczki" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Podgląd jest liczony z Twojego własnego Icon.utx. Zaznacz paczki i kliknij „Zastosuj”." />
                <ItemsControl ItemsSource="{Binding Packs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PackViewModel">
                      <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                        <StackPanel Spacing="6">
                          <Grid ColumnDefinitions="*,Auto">
                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEditable}">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            </CheckBox>
                            <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Text="{Binding SizeText}" />
                          </Grid>
                          <ItemsControl ItemsSource="{Binding Thumbnails}" Margin="28,0,0,0">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ThumbnailViewModel">
                                <Border Margin="0,0,6,6" BorderBrush="Black" BorderThickness="1" ToolTip.Tip="{Binding Target}">
                                  <Image Width="64" Height="64" Stretch="Fill"
                                         RenderOptions.BitmapInterpolationMode="None"
                                         Source="{Binding Image, Converter={x:Static views:RgbaImageConverter.Instance}}" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Classes="muted" FontSize="12" Margin="28,0,0,0" Text="{Binding PreviewNote}"
                                     IsVisible="{Binding PreviewNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="accent" Content="Zastosuj" Command="{Binding ApplyCommand}" />
                  <Button Content="Przywróć oryginał" Command="{Binding RestoreOriginalCommand}"
                          ToolTip.Tip="Przywraca kopię oryginalnego Icon.utx zrobioną przed pierwszą zmianą." />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="heading" Text="Ustawienia gry (Option.ini)" />
                <TextBlock Classes="muted" Text="Lider nie udostępnił presetów." IsVisible="{Binding !HasPresets}" />
                <ItemsControl ItemsSource="{Binding Presets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PresetViewModel">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <StackPanel Spacing="2">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Classes="muted" Text="(ustawiony)" IsVisible="{Binding IsApplied}" />
                          </StackPanel>
                          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Summary}" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Content="Ustaw"
                                Command="{Binding $parent[views:DashboardView].((vm:DashboardViewModel)DataContext).ApplyPresetCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Przywróć moje ustawienia" Command="{Binding RestoreMySettingsCommand}"
                        ToolTip.Tip="Przywraca Option.ini sprzed pierwszego presetu." />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Right column: announcements, launcher settings, details -->
          <StackPanel Grid.Column="1" Spacing="12">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="heading" Text="Ogłoszenia" />
                <TextBlock Classes="muted" Text="Brak ogłoszeń." IsVisible="{Binding !HasAnnouncements}" />
                <ItemsControl ItemsSource="{Binding Announcements}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AnnouncementViewModel">
                      <StackPanel Spacing="2" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" Classes="muted" Margin="8,0,0,0" Text="{Binding DateText}" />
                        </Grid>
                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Expander Header="Ustawienia launchera" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <TextBlock Classes="muted" Text="Źródło przepisów (adres https:// albo folder):" />
                <TextBox Text="{Binding ManifestSourceText}" PlaceholderText="https://…/cp/" />
                <TextBlock Classes="muted" Text="Program uruchamiany przyciskiem „Uruchom L2Dex”:" />
                <ComboBox ItemsSource="{Binding GameExecutableOptions}" SelectedItem="{Binding SelectedGameExecutable}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="services:GameExecutableOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Zapisz" Command="{Binding SaveSettingsCommand}" />
                  <Button Content="Zmień folder klienta" Command="{Binding ChangeClientFolderCommand}" />
                </StackPanel>
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SettingsMessage}"
                           IsVisible="{Binding SettingsMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Expander>

            <Expander Header="Szczegóły techniczne" HorizontalAlignment="Stretch">
              <ItemsControl ItemsSource="{Binding Details}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
