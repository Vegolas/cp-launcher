<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CpLauncher.ViewModels"
             xmlns:views="clr-namespace:CpLauncher.Views"
             xmlns:services="clr-namespace:CpLauncher.Services"
             x:Class="CpLauncher.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <Grid RowDefinitions="Auto,*">
    <!--
      Title bar: emblem, name and version on the left; Odśwież, Ustawienia and the gold game start before the
      window's caption buttons. Controls in the drag region need ElementRole="User": the window's hit test ignores
      elements without a role, so a click would fall through to the TitleBar and move the window instead.
    -->
    <Border Classes="titlebar" WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,0,156,0">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Path Classes="mark" VerticalAlignment="Center" />
          <TextBlock Classes="brand" Text="VEGGIE LAUNCHER" VerticalAlignment="Center" />
          <TextBlock Classes="muted small" Text="{Binding LauncherVersionText}" VerticalAlignment="Center" Margin="-2,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="ghost" Command="{Binding RefreshCommand}" WindowDecorationProperties.ElementRole="User"
                  ToolTip.Tip="Pobiera przepisy jeszcze raz i sprawdza Icon.utx.">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="glyph" Text="&#xE72C;" />
              <TextBlock Text="Odśwież" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <ToggleButton Classes="ghost" IsChecked="{Binding IsSettingsOpen}" WindowDecorationProperties.ElementRole="User">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="glyph" Text="&#xE713;" />
              <TextBlock Text="Ustawienia" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <Border Width="1" Height="28" Background="#2A313B" Margin="8,0,10,0" />
          <Border Classes="gold-glow">
            <Button Classes="gold play" Command="{Binding LaunchGameCommand}" WindowDecorationProperties.ElementRole="User">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="glyph" FontSize="13" Text="&#xE768;" VerticalAlignment="Center" />
                <TextBlock Text="URUCHOM L2DEX" LetterSpacing="1.4" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main page: the hero with the guide's dialog on top, the sections below scroll -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding !IsSettingsOpen}">
      <!--
        Hero. The art layers never set its height (the dragon sits in a Canvas, the guide is shorter than MinHeight):
        the dialog does, so long texts grow the hero instead of being cut off.
      -->
      <Panel MinHeight="256" Background="{StaticResource HeroBrush}">
        <Border IsHitTestVisible="False">
          <Border.Background>
            <RadialGradientBrush Center="13%,100%" GradientOrigin="13%,100%" RadiusX="34%" RadiusY="80%">
              <GradientStop Offset="0" Color="#21D9A93F" />
              <GradientStop Offset="1" Color="#00D9A93F" />
            </RadialGradientBrush>
          </Border.Background>
        </Border>

        <Panel Name="HeroArt" Width="500" HorizontalAlignment="Right" ClipToBounds="True" IsHitTestVisible="False">
          <Panel.OpacityMask>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Offset="0" Color="#00000000" />
              <GradientStop Offset="0.3" Color="#FF000000" />
            </LinearGradientBrush>
          </Panel.OpacityMask>
          <Canvas>
            <Image Canvas.Left="0" Canvas.Top="-90" Width="500" Height="667" Stretch="UniformToFill" Opacity="0.9"
                   Source="{x:Static views:Art.Dragon}" />
          </Canvas>
          <Border Height="56" VerticalAlignment="Bottom">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#0007090C" />
                <GradientStop Offset="1" Color="#FF07090C" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Panel>

        <Ellipse Width="170" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="44,0,0,4"
                 Fill="{StaticResource GroundShadow}" IsHitTestVisible="False" />
        <Image Name="Guide" Height="250" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="36,0,0,0"
               Source="{x:Static views:Art.Guide}" IsHitTestVisible="False" />

        <!-- Status of Icon.utx and the actions on it, said by the guide; the last line is the result of the last action -->
        <HeaderedContentControl Name="StatusDialog" Theme="{StaticResource GuideDialog}"
                                Width="440" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="240,24,24,28"
                                Padding="18,13,18,14"
                                Classes.success="{Binding IconState.IsSuccess}"
                                Classes.warning="{Binding IconState.IsWarning}"
                                Classes.error="{Binding IconState.IsError}"
                                Classes.pending="{Binding HasPendingChanges}">
          <StackPanel>
            <TextBlock Classes="headline" Text="{Binding IconState.Text}" />
            <TextBlock Classes="prose" Margin="0,4,0,0" Foreground="{StaticResource ProseBrush}" Text="{Binding PendingText}"
                       IsVisible="{Binding PendingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="muted small" Margin="0,5,0,0" TextWrapping="Wrap" Text="{Binding ManifestSummary}" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,13,0,0">
              <Button Classes="apply" Content="ZASTOSUJ" Command="{Binding ApplyCommand}" />
              <Button Classes="quiet" Content="Przywróć oryginał" Command="{Binding RestoreOriginalCommand}"
                      IsVisible="{Binding HasOriginalToRestore}"
                      ToolTip.Tip="Przywraca kopię oryginalnego Icon.utx zrobioną przed pierwszą zmianą." />
            </StackPanel>
            <Border Margin="0,12,0,0" Padding="0,10,0,0" BorderBrush="#1E252F" BorderThickness="0,1,0,0">
              <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                  <Binding Path="IsBusy" />
                  <Binding Path="LastAction" Converter="{x:Static ObjectConverters.IsNotNull}" />
                </MultiBinding>
              </Border.IsVisible>
              <Panel>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" MaxWidth="240" HorizontalAlignment="Left" />
                <Border Classes="notice quiet"
                        Classes.success="{Binding LastAction.IsSuccess}"
                        Classes.warning="{Binding LastAction.IsWarning}"
                        Classes.error="{Binding LastAction.IsError}">
                  <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="!IsBusy" />
                      <Binding Path="LastAction" Converter="{x:Static ObjectConverters.IsNotNull}" />
                    </MultiBinding>
                  </Border.IsVisible>
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="glyph" />
                    <TextBlock Grid.Column="1" FontSize="12.5" LineHeight="17" Foreground="#C9C3B8" TextWrapping="Wrap"
                               Text="{Binding LastAction.Text}" />
                  </Grid>
                </Border>
              </Panel>
            </Border>
          </StackPanel>
        </HeaderedContentControl>

        <!-- Floor of the hero: a gold line with a diamond in the middle -->
        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource GoldFadeLine}" IsHitTestVisible="False" />
        <Border Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4"
                Background="{StaticResource GoldBrush}" BoxShadow="0 0 0 2 #07090C" RenderTransform="rotate(45deg)"
                IsHitTestVisible="False" />
      </Panel>

      <ScrollViewer Grid.Row="1">
        <StackPanel Margin="24,18,24,24" Spacing="16" MaxWidth="1200">
          <!-- Launcher update -->
          <Border Classes="notice update" IsVisible="{Binding UpdateText, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Classes="glyph" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="strong" Text="{Binding UpdateText}" TextWrapping="Wrap" />
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding UpdateHint}"
                           IsVisible="{Binding UpdateHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <Button Grid.Column="2" Classes="apply" Margin="16,0,0,0" VerticalAlignment="Center" Content="AKTUALIZUJ"
                      Command="{Binding UpdateLauncherCommand}"
                      ToolTip.Tip="Pobiera nową wersję, sprawdza ją z podpisanymi przepisami i uruchamia launcher ponownie." />
            </Grid>
          </Border>

          <!-- Banners -->
          <ItemsControl ItemsSource="{Binding Banners}" IsVisible="{Binding !!Banners.Count}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NoticeViewModel">
                <Border Classes="notice"
                        Classes.success="{Binding IsSuccess}"
                        Classes.warning="{Binding IsWarning}"
                        Classes.error="{Binding IsError}">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="glyph" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="*,18,312">
            <!-- Packs; this and the right column's sections collapse, and the launcher remembers it -->
            <Expander Theme="{StaticResource SectionExpander}" IsExpanded="{Binding PacksSection.IsExpanded, Mode=TwoWay}">
              <Expander.Header>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="caps" Text="PACZKI" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="muted small" VerticalAlignment="Center" Margin="12,0,0,0"
                             Text="{Binding PacksSection.Summary}" IsVisible="{Binding !PacksSection.IsExpanded}" />
                </Grid>
              </Expander.Header>
              <StackPanel>
                <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap"
                           Text="Podgląd liczony z Twojego Icon.utx. Zaznacz paczki i kliknij „Zastosuj”." />
                <TextBlock Classes="muted" Margin="0,12,0,0" TextWrapping="Wrap" Text="Lider nie udostępnił paczek."
                           IsVisible="{Binding !Packs.Count}" />
                <ItemsControl Name="PacksList" ItemsSource="{Binding Packs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PackViewModel">
                      <Border Classes="pack" Classes.off="{Binding !IsSelected}" Padding="0,12,0,2"
                              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0">
                        <StackPanel>
                          <Grid ColumnDefinitions="*,Auto">
                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEditable}" MinHeight="0">
                              <TextBlock Classes="strong" FontSize="14.5" Text="{Binding Name}" TextWrapping="Wrap" />
                            </CheckBox>
                            <Border Grid.Column="1" Classes="count" Margin="12,0,0,0">
                              <TextBlock Classes="muted" FontSize="11.5" Text="{Binding SizeText}" />
                            </Border>
                          </Grid>
                          <TextBlock Classes="muted" FontSize="12.5" LineHeight="17" TextWrapping="Wrap" Margin="28,2,0,0"
                                     Text="{Binding Description}"
                                     IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <StackPanel Classes="strip" Orientation="Horizontal" Margin="28,10,0,0">
                            <ItemsControl ItemsSource="{Binding Thumbnails}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThumbnailViewModel">
                                  <Border Classes="iconslot" ToolTip.Tip="{Binding Target}">
                                    <Panel>
                                      <Image Width="32" Height="32" Stretch="Fill"
                                             RenderOptions.BitmapInterpolationMode="None"
                                             Source="{Binding Image, Converter={x:Static views:RgbaImageConverter.Instance}}" />
                                      <Border Classes="flash" />
                                    </Panel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Classes="iconslot"
                                    IsVisible="{Binding OverflowText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                              <Panel>
                                <TextBlock FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding OverflowText}" />
                                <Border Classes="flash" />
                              </Panel>
                            </Border>
                          </StackPanel>
                          <TextBlock Classes="muted small" Margin="28,6,0,0" TextWrapping="Wrap" Text="{Binding PreviewNote}"
                                     IsVisible="{Binding PreviewNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Expander>

            <!-- Right column: announcements, Option.ini presets -->
            <StackPanel Grid.Column="2" Spacing="18">
              <Expander Theme="{StaticResource SectionExpander}" IsExpanded="{Binding AnnouncementsSection.IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="caps" Text="OGŁOSZENIA" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="muted small" VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="{Binding AnnouncementsSection.Summary}" IsVisible="{Binding !AnnouncementsSection.IsExpanded}" />
                  </Grid>
                </Expander.Header>
                <StackPanel Spacing="14">
                  <TextBlock Classes="muted" Text="Brak ogłoszeń od lidera." IsVisible="{Binding !HasAnnouncements}" />
                  <ItemsControl ItemsSource="{Binding Announcements}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="16" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AnnouncementViewModel">
                        <StackPanel Spacing="3">
                          <TextBlock FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="12" LetterSpacing="1"
                                     Foreground="{StaticResource GoldBrush}" Text="{Binding DateText}" />
                          <TextBlock Classes="strong" Text="{Binding Title}" TextWrapping="Wrap" />
                          <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="19" FontSize="13" Foreground="#C9C3B8" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Expander>

              <Expander Theme="{StaticResource SectionExpander}" IsExpanded="{Binding PresetsSection.IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="caps" Text="USTAWIENIA GRY" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="muted small" VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="{Binding PresetsSection.Summary}" IsVisible="{Binding !PresetsSection.IsExpanded}" />
                  </Grid>
                </Expander.Header>
                <StackPanel Spacing="12">
                  <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" Text="Zmieniają tylko wybrane linie w Option.ini." />
                  <TextBlock Classes="muted" Text="Lider nie udostępnił presetów." IsVisible="{Binding !HasPresets}" />
                  <ItemsControl ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PresetViewModel">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Classes="strong" Text="{Binding Name}" />
                              <TextBlock Classes="glyph" FontSize="12" Text="&#xE73E;" Foreground="{StaticResource SuccessBrush}"
                                         VerticalAlignment="Center" IsVisible="{Binding IsApplied}"
                                         ToolTip.Tip="Ustawiony w Twoim Option.ini" />
                            </StackPanel>
                            <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding Summary}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="small" VerticalAlignment="Center" Margin="12,0,0,0" Content="Ustaw"
                                  Command="{Binding $parent[views:DashboardView].((vm:DashboardViewModel)DataContext).ApplyPresetCommand}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Classes="ghost" MinHeight="30" Padding="8,0" Margin="-8,0,0,0" HorizontalAlignment="Left"
                          Content="Przywróć moje ustawienia"
                          Command="{Binding RestoreMySettingsCommand}" IsVisible="{Binding HasSettingsBackup}"
                          ToolTip.Tip="Przywraca Option.ini sprzed pierwszego presetu." />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Launcher settings and technical details; the dwarf stands on the right and faces the form -->
    <Grid Grid.Row="1" ColumnDefinitions="*,0.62*" IsVisible="{Binding IsSettingsOpen}">
      <Border Grid.ColumnSpan="2" IsHitTestVisible="False">
        <Border.Background>
          <RadialGradientBrush Center="80%,82%" GradientOrigin="80%,82%" RadiusX="30%" RadiusY="58%">
            <GradientStop Offset="0" Color="#21D9A93F" />
            <GradientStop Offset="1" Color="#00D9A93F" />
          </RadialGradientBrush>
        </Border.Background>
      </Border>
      <Border Grid.Column="1" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,40"
              Background="{StaticResource GoldFadeLine}" IsHitTestVisible="False" />
      <Ellipse Grid.Column="1" Width="300" Height="26" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
               Fill="{StaticResource GroundShadow}" IsHitTestVisible="False" />
      <Image Grid.Column="1" Source="{x:Static views:Art.Dwarf}" Stretch="Uniform" MaxHeight="540"
             HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,24,24,40" IsHitTestVisible="False" />

      <ScrollViewer>
        <StackPanel Margin="24,20,24,24" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="ghost" Command="{Binding CloseSettingsCommand}" ToolTip.Tip="Wróć do paczek" Padding="10,0">
              <TextBlock Classes="glyph" Text="&#xE72B;" />
            </Button>
            <TextBlock Classes="page-title" Text="USTAWIENIA" VerticalAlignment="Center" />
          </StackPanel>

          <!-- "Uruchom L2Dex" stays in the title bar, so its result is shown here too -->
          <Border Classes="notice quiet"
                  Classes.success="{Binding LastAction.IsSuccess}"
                  Classes.warning="{Binding LastAction.IsWarning}"
                  Classes.error="{Binding LastAction.IsError}"
                  IsVisible="{Binding LastAction, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Classes="glyph" />
              <TextBlock Grid.Column="1" FontSize="12.5" Foreground="#C9C3B8" TextWrapping="Wrap" Text="{Binding LastAction.Text}" />
            </Grid>
          </Border>

          <Border Classes="panel">
            <StackPanel Spacing="16">
              <StackPanel Spacing="8">
                <TextBlock Classes="heading" Text="Klient L2Dex" />
                <Grid ColumnDefinitions="*,Auto">
                  <Border Classes="readout" MinHeight="38">
                    <SelectableTextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ClientDirectory}" />
                  </Border>
                  <Button Grid.Column="1" Margin="10,0,0,0" MinHeight="38" VerticalContentAlignment="Center"
                          Command="{Binding ChangeClientFolderCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="glyph" FontSize="14" Text="&#xE838;" VerticalAlignment="Center" />
                      <TextBlock Text="Zmień folder klienta" />
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>

              <Separator Theme="{StaticResource Ornament}" />

              <StackPanel Spacing="8">
                <TextBlock Classes="heading" Text="Uruchamianie gry" />
                <TextBlock Classes="muted" Text="Program uruchamiany przyciskiem „Uruchom L2Dex”:" />
                <ComboBox ItemsSource="{Binding GameExecutableOptions}" SelectedItem="{Binding SelectedGameExecutable}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="services:GameExecutableOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <Separator Theme="{StaticResource Ornament}" />

              <StackPanel Spacing="8">
                <TextBlock Classes="heading" Text="Źródło przepisów" />
                <TextBlock Classes="muted prose"
                           Text="Adres https:// albo folder, z którego launcher pobiera podpisane przepisy. Zostaw puste, żeby używać źródła CP." />
                <TextBox Text="{Binding ManifestSourceText}" PlaceholderText="Źródło CP (domyślne)" />
                <TextBlock Classes="muted small" TextWrapping="Wrap">
                  <Run Text="Teraz używane:" />
                  <Run Text="{Binding ManifestSourceDescription}" />
                </TextBlock>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                <Button Classes="apply" Content="ZAPISZ" MinWidth="120" Command="{Binding SaveSettingsCommand}" />
                <TextBlock Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding SettingsMessage}"
                           IsVisible="{Binding SettingsMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="panel" Padding="0">
            <StackPanel>
              <Border Classes="panel-header">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Path Classes="diamond" VerticalAlignment="Center" />
                  <TextBlock Classes="caps" Text="SZCZEGÓŁY TECHNICZNE" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <StackPanel Margin="16,12,16,16" Spacing="10">
                <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap"
                           Text="Komunikaty, które przydadzą się liderowi, gdy coś nie działa. Można je zaznaczyć i skopiować." />
                <TextBlock Classes="muted" Text="Brak uwag." IsVisible="{Binding !Details.Count}" />
                <ItemsControl ItemsSource="{Binding Details}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Classes="readout" Padding="10,6">
                        <SelectableTextBlock Classes="small" Text="{Binding}" TextWrapping="Wrap" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
