<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CpLauncher.ViewModels"
             x:Class="CpLauncher.Views.SetupView"
             x:DataType="vm:SetupViewModel">
  <ScrollViewer>
    <Border Classes="card" Margin="24" MaxWidth="680" Padding="28"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14">
        <TextBlock Classes="title" Text="CP Launcher" />
        <TextBlock TextWrapping="Wrap"
                   Text="Launcher nakłada zmiany kosmetyczne naszego CP (znaczki buffów, tagi debuffów, oznaczenia przedmiotów) na Twój plik Icon.utx i potrafi w każdej chwili przywrócić oryginał." />
        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                   Text="Najpierw wskaż folder, w którym jest zainstalowany klient L2Dex." />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding RequiredFilesText}" />

        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding ClientDirectory}" PlaceholderText="np. C:\Lineage2Dex" />
          <Button Grid.Column="1" Margin="8,0,0,0" Content="Wybierz…" Command="{Binding BrowseCommand}" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Errors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Border Classes="notice error" Margin="0,0,0,4">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Anuluj" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" />
          <Button Classes="accent" Content="Dalej" Command="{Binding ContinueCommand}" />
        </StackPanel>

        <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                   Text="Launcher zmienia tylko SysTextures\Icon.utx i (na Twoje życzenie) system_season\Option.ini. Kopie oryginałów trzyma we własnym folderze danych." />
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
