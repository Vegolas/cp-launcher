<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CpLauncher.ViewModels"
        xmlns:views="clr-namespace:CpLauncher.Views"
        x:Class="CpLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Veggie launcher"
        Width="1080" Height="780"
        MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="56"
        WindowDecorations="Full"
        Background="{StaticResource PageBrush}">
  <!-- The pages draw their own title bar (Border.titlebar); Windows keeps its caption buttons on the right. -->
  <Window.DataTemplates>
    <DataTemplate DataType="vm:SetupViewModel">
      <views:SetupView />
    </DataTemplate>
    <DataTemplate DataType="vm:DashboardViewModel">
      <views:DashboardView />
    </DataTemplate>
  </Window.DataTemplates>

  <Panel>
    <!-- Drag region while no page is shown yet. -->
    <Border Classes="titlebar" VerticalAlignment="Top" WindowDecorationProperties.ElementRole="TitleBar" />
    <ContentControl Content="{Binding CurrentPage}" />
    <TextBlock Text="Wczytywanie…"
               Classes="muted"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.IsNull}}" />
  </Panel>
</Window>
