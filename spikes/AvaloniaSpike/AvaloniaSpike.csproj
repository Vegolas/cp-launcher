<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 0 spike: is a single-exe Avalonia launcher viable (size, start time, trimming/AOT)? Throwaway. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- The real engine; L2Mod.Core is IsAotCompatible, so trimming/AOT is exercised on our own code as well. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\L2Mod.Core\L2Mod.Core.csproj" />
  </ItemGroup>

</Project>
